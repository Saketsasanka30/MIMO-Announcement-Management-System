rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'type',
          'date',
          'status',
          'createdAt',
          'updatedAt',
          'authorId'
        ]) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 160 &&
        data.description is string &&
        data.description.size() >= 1 &&
        data.description.size() <= 3000 &&
        data.type is string &&
        data.type in ['General', 'Important', 'Maintenance'] &&
        data.date is timestamp &&
        data.status is string &&
        data.status in ['Published', 'Draft'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        isValidId(data.authorId) &&
        (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 256));
    }

    match /announcements/{announcementId} {
      // Anyone can get a published notice; signed-in users can read any notice
      allow get: if isValidId(announcementId) && (
        (resource != null && resource.data.status == 'Published') || isSignedIn()
      );

      // Public users can query published notices; signed-in users can query all notices
      allow list: if (resource != null && resource.data.status == 'Published') || isSignedIn();

      // Any signed-in user can create an announcement (open to all admins)
      allow create: if isValidId(announcementId) &&
        isSignedIn() &&
        incoming().authorId == request.auth.uid &&
        isValidAnnouncement(incoming());

      // Any signed-in user can update an announcement
      allow update: if isValidId(announcementId) &&
        isSignedIn() && (
          !('title' in incoming()) || (incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 160)
        ) && (
          !('description' in incoming()) || (incoming().description is string && incoming().description.size() >= 1 && incoming().description.size() <= 3000)
        ) && (
          !('status' in incoming()) || (incoming().status in ['Published', 'Draft'])
        ) && (
          !('type' in incoming()) || (incoming().type in ['General', 'Important', 'Maintenance'])
        );

      // Any signed-in user can delete an announcement
      allow delete: if isValidId(announcementId) && isSignedIn();
    }

    // Admins collection: any signed-in user can manage admin entries
    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }
  }
}
